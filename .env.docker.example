APP_PORT=8000
MATERIALBIN_DEBUG=false
MATERIALBIN_IMAGE_REPOSITORY=ghcr.io/fifcom/materialbin
MATERIALBIN_IMAGE_TAG=latest
# Backward compatible alternative for existing deployments: MATERIALBIN_IMAGE=ghcr.io/fifcom/materialbin:latest
MATERIALBIN_DATA_VOLUME=materialbin_data

# Optional: only used when building locally with compose.build.yaml. The build also
# creates ${MATERIALBIN_IMAGE_REPOSITORY}:${APP_VERSION} for the current source version.
APP_UID=1000
APP_GID=1000

# These intentionally use unsafe defaults that the app rejects in production.
# Replace them before starting containers.
SECRET_KEY=your-secret-key-change-this-in-production
MEMBER_TOKEN_SECRET_KEY=change-this-member-token-secret-key-in-production
INTERNAL_TOKEN=change-this-internal-token-in-production

# Default container database mode: SQLite.
DB_DRIVER=sqlite
SQLITE_PATH=/app/data/material_bin.db
DATA_DIR=/app/data
CLEANUP_INTERVAL_SECONDS=900
CLEANUP_RUN_ON_START=true
# Optional: limit cleanup to specific tasks, space-separated.
# CLEANUP_TASKS=expired_drafts expired_pastes expired_members
# Recommended default: keep MATERIALBIN_DATA_VOLUME as a Docker named volume.
# Optional: use a bind mount instead, but make sure UID 1000 can write it:
#   mkdir -p docker-data && sudo chown 1000:1000 docker-data
# MATERIALBIN_DATA_VOLUME=./docker-data

# Optional MySQL settings. Enable them with:
# docker compose --env-file .env.docker -f compose.yaml -f compose.mysql.yaml up -d
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=material_bin
MYSQL_USER=material_bin
MYSQL_PASSWORD=material_bin
MYSQL_ROOT_PASSWORD=materialbin-root-password
