# 应用配置
APP_NAME="Material Bin"
VERSION="0.1.0"
DEBUG=true

# 数据库配置
DATABASE_URL="sqlite:///./material_bin.db"
# MYSQL_DATABASE_URL="mysql+pymysql://username:password@localhost:3306/material_bin"

# 安全配置
SECRET_KEY="your-secret-key-change-this-in-production"
# 协作房间 member token 使用的独立密钥（必须显式设置，且建议与 SECRET_KEY 分离）
MEMBER_TOKEN_SECRET_KEY="change-this-member-token-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 加密配置
PBKDF2_ITERATIONS=100000
SALT_LENGTH=32
ENCRYPTION_KEY_LENGTH=16
SESSION_KEY_LENGTH=32

# 服务器配置
HOST="127.0.0.1"
PORT='8000'

DATA_DIR="./data"

# 上传限制（字节）
# 说明：用于限制单个文件的“原始明文大小”（分片上传会在 init 阶段校验）。
MAX_UPLOAD_FILE_SIZE=10485760
# 分片上传限制（字节）
MAX_CHUNK_SIZE=2097152
# 上传会话过期（秒）
UPLOAD_EXPIRE_SECONDS=3600
# 最大并发上传会话数（全局）
MAX_CONCURRENT_UPLOADS=20

# 内部服务配置
INTERNAL_TOKEN="change-this-internal-token-in-production"
