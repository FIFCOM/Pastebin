# 应用配置
APP_NAME="Material Bin"
DEBUG=true

# 数据库配置
DATABASE_URL="sqlite:///./material_bin.db" # MySQL 示例：mysql+pymysql://username:password@localhost:3306/material_bin

# 安全配置
SECRET_KEY="your-secret-key-change-this-in-production"
# 协作房间 member token 使用的独立密钥（必须显式设置，且建议与 SECRET_KEY 分离）
MEMBER_TOKEN_SECRET_KEY="change-this-member-token-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# 加密配置
PBKDF2_ITERATIONS=100000
SALT_LENGTH=32
ENCRYPTION_KEY_LENGTH=16
SESSION_KEY_LENGTH=32

# 服务器配置
HOST="127.0.0.1"
PORT='8000'

DATA_DIR="./data"

# 内部服务配置
INTERNAL_TOKEN="change-this-internal-token-in-production"
